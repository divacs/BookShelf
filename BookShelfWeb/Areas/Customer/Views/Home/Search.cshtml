@model BookShelfWeb.ViewModels.SearchResultsViewModel

@{
    ViewData["Title"] = "Browse Books";
}

<section class="mb-4">
    <div class="panel-card">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-end">
            <div>
                <h1 class="fw-bold mb-1">Browse the Catalog</h1>
                <p class="text-muted mb-0">Filter by genre or search by title, author, and tags.</p>
            </div>
            <form asp-action="Search" method="get" class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label">Search</label>
                    <input type="text" name="query" value="@Model.Query" class="form-control" placeholder="Programming, mystery, Mira..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Category</label>
                    <select name="category" class="form-select">
                        <option value="">All categories</option>
                        @foreach (var category in Model.Categories)
                        {
                            if (Model.Category == category)
                            {
                                <option value="@category" selected>@category</option>
                            }
                            else
                            {
                                <option value="@category">@category</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
                </div>
            </form>
        </div>
    </div>
</section>

<section>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold mb-0">Results</h2>
        <span class="text-muted">@Model.Results.Count books found</span>
    </div>

    @if (!Model.Results.Any())
    {
        <div class="alert alert-light border">No books match the current filters. Try a broader keyword or clear the category.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var book in Model.Results)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <partial name="_BookCard" model="book" />
                </div>
            }
        </div>
    }
</section>

<style>
    .panel-card {
        background: #fff;
        border-radius: 1.25rem;
        padding: 1.5rem;
        box-shadow: 0 18px 45px rgba(18, 38, 63, 0.12);
    }
</style>
