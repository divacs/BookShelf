@model BookShelfWeb.ViewModels.StorefrontHomeViewModel

@{
    ViewData["Title"] = "BookShelf";
}

<section class="hero-shelf rounded-4 overflow-hidden mb-5">
    <div class="row g-0 align-items-center">
        <div class="col-lg-7 p-5">
            <span class="badge bg-light text-dark mb-3 px-3 py-2">Curated Summer 2026 Collection</span>
            <h1 class="display-4 fw-bold text-white mb-3">Discover your next favorite book.</h1>
            <p class="lead text-white-50 mb-4">Browse bestselling fiction, fantasy, sci-fi, business, psychology, and programming titles, all in one thoughtfully curated collection.</p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-action="Search" class="btn btn-warning btn-lg px-4">Browse All Books</a>
                <a asp-action="Search" asp-route-category="Programming" class="btn btn-outline-light btn-lg px-4">Shop Programming</a>
            </div>
        </div>
        <div class="col-lg-5 p-4">
            <div class="hero-panel rounded-4 p-4 bg-white">
                <h5 class="fw-semibold mb-3">Shop by Category</h5>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var category in Model.Categories)
                    {
                        <a asp-action="Search" asp-route-category="@category" class="btn btn-sm btn-outline-primary rounded-pill px-3">@category</a>
                    }
                </div>
                <hr />
                <p class="text-muted mb-1">Highlights</p>
                <ul class="mb-0">
                    <li>18 distinct books with original local covers</li>
                    <li>Featured, bestselling, discounted, and new release sections</li>
                    <li>Mock customer cart, wishlist, and order history</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-title">Featured Books</h2>
        <a asp-action="Search" class="text-decoration-none">View catalog</a>
    </div>
    <div class="row g-4">
        @foreach (var book in Model.FeaturedBooks)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <partial name="_BookCard" model="book" />
            </div>
        }
    </div>
</section>

<section class="mb-5">
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="panel-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="section-title">Bestsellers</h2>
                    <span class="small text-muted">Top by units sold</span>
                </div>
                @foreach (var book in Model.Bestsellers)
                {
                    <div class="d-flex gap-3 border-bottom py-3">
                        <img src="@book.Product.ImageUrl" alt="@book.Product.Title" class="mini-cover" />
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between gap-3">
                                <div>
                                    <h6 class="mb-1">@book.Product.Title</h6>
                                    <p class="text-muted small mb-1">@book.Product.Author</p>
                                </div>
                                <span class="badge rounded-pill bg-warning text-dark">@book.UnitsSold sold</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-end">
                                <small class="text-muted">@book.CategoryName</small>
                                <a asp-action="Details" asp-route-productId="@book.Product.Id" class="btn btn-sm btn-outline-primary">Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="panel-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="section-title">New Arrivals</h2>
                    <span class="small text-muted">Fresh additions</span>
                </div>
                @foreach (var book in Model.NewArrivals)
                {
                    <div class="d-flex gap-3 border-bottom py-3">
                        <img src="@book.Product.ImageUrl" alt="@book.Product.Title" class="mini-cover" />
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between gap-3">
                                <div>
                                    <h6 class="mb-1">@book.Product.Title</h6>
                                    <p class="text-muted small mb-1">@book.Publisher</p>
                                </div>
                                <span class="badge rounded-pill bg-success">@book.PublishedYear</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-end">
                                <small class="text-muted">@book.PageCount pages</small>
                                <a asp-action="Details" asp-route-productId="@book.Product.Id" class="btn btn-sm btn-outline-primary">Open</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-title">All Books</h2>
        <form asp-action="Search" method="get" class="d-flex gap-2">
            <input type="text" name="query" class="form-control" placeholder="Search title, author, or tag" />
            <button type="submit" class="btn btn-primary">Search</button>
        </form>
    </div>
    <div class="row g-4">
        @foreach (var book in Model.AllBooks)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <partial name="_BookCard" model="book" />
            </div>
        }
    </div>
</section>

<style>
    .hero-shelf {
        background: linear-gradient(120deg, #133c55 0%, #1f6f8b 55%, #f4b860 100%);
    }

    .hero-panel,
    .panel-card {
        border-radius: 1.25rem;
        box-shadow: 0 18px 45px rgba(18, 38, 63, 0.12);
    }

    .panel-card {
        background: #fff;
        padding: 1.5rem;
    }

    .section-title {
        font-weight: 700;
        margin-bottom: 0;
    }

    .mini-cover {
        width: 68px;
        height: 96px;
        object-fit: cover;
        border-radius: 0.9rem;
        box-shadow: 0 10px 24px rgba(16, 24, 40, 0.12);
    }
</style>
