@model BookShelfWeb.ViewModels.StoreBookViewModel

<div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden book-card">
    <img src="@Model.Product.ImageUrl" alt="@Model.Product.Title" class="card-img-top" style="height: 320px; object-fit: cover;" />
    <div class="card-body d-flex flex-column">
        <div class="d-flex flex-wrap gap-2 mb-2">
            @if (Model.IsFeatured)
            {
                <span class="badge bg-dark">Featured</span>
            }
            @if (Model.IsBestseller)
            {
                <span class="badge bg-warning text-dark">Bestseller</span>
            }
            @if (Model.IsNewRelease)
            {
                <span class="badge bg-success">New</span>
            }
        </div>
        <small class="text-uppercase text-muted">@Model.CategoryName</small>
        <h5 class="mt-1">@Model.Product.Title</h5>
        <p class="text-muted mb-1">@Model.Product.Author</p>
        <p class="small text-muted flex-grow-1">@Model.ShortDescription</p>
        <div class="d-flex justify-content-between align-items-end mb-3">
            <div>
                <div class="text-warning fw-semibold">@Model.AverageRating.ToString("0.0")/5</div>
                <small class="text-muted">@Model.ReviewCount reviews</small>
            </div>
            <div class="text-end">
                <div class="text-muted small" style="text-decoration: line-through;">@Model.Product.ListPrice.ToString("C")</div>
                <div class="fw-bold text-danger fs-5">@Model.Product.Price.ToString("C")</div>
            </div>
        </div>
        <a asp-area="Customer" asp-controller="Home" asp-action="Details" asp-route-productId="@Model.Product.Id" class="btn btn-primary mt-auto">View Details</a>
    </div>
</div>

<style>
    .book-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .book-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 38px rgba(16, 24, 40, 0.18);
    }
</style>
