@model BookShelfWeb.ViewModels.WishlistViewModel

<section class="mb-4">
    <h1 class="fw-bold">Wishlist</h1>
    <p class="text-muted">Saved books that fit the mood of a thoughtful, premium online bookstore.</p>
</section>

<div class="row g-4">
    @foreach (var book in Model.Books)
    {
        <div class="col-xl-3 col-lg-4 col-md-6">
            <partial name="~/Areas/Customer/Views/Home/_BookCard.cshtml" model="book" />
        </div>
    }
</div>
