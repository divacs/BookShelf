@model IReadOnlyList<BookShelfWeb.ViewModels.OrderHistoryItemViewModel>

<section class="mb-4">
    <h1 class="fw-bold">Order History</h1>
    <p class="text-muted">Three realistic orders with mixed fulfillment states for customer account screenshots.</p>
</section>

@foreach (var order in Model)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-3">
                <div>
                    <h5 class="mb-1">Order #@order.OrderId</h5>
                    <p class="text-muted mb-0">@order.OrderDate.ToString("MMMM d, yyyy")</p>
                </div>
                <div class="text-lg-end">
                    <div><span class="badge bg-primary">@order.Status</span></div>
                    <small class="text-muted">Tracking: @order.TrackingNumber</small>
                </div>
            </div>
            @foreach (var line in order.Lines)
            {
                <div class="d-flex gap-3 align-items-center border-top py-3">
                    <img src="@line.ImageUrl" alt="@line.Title" style="width: 54px; height: 76px; object-fit: cover; border-radius: 0.75rem;" />
                    <div class="flex-grow-1">
                        <h6 class="mb-1">@line.Title</h6>
                        <small class="text-muted">Qty @line.Quantity</small>
                    </div>
                    <div class="fw-semibold">@line.UnitPrice.ToString("C")</div>
                </div>
            }
            <div class="d-flex justify-content-between border-top pt-3">
                <span class="text-muted">Payment: @order.PaymentStatus</span>
                <strong>Total: @order.OrderTotal.ToString("C")</strong>
            </div>
        </div>
    </div>
}
